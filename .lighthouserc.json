{
  "ci": {
    "collect": {
      "url": [
        "https://argamanclinic.com/",
        "https://argamanclinic.com/services.html",
        "https://argamanclinic.com/contact.html",
        "https://argamanclinic.com/yeutz-zugi-tel-aviv.html",
        "https://argamanclinic.com/eich-lehatzil-zugiyut-aharei-begida.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "is-on-https": "error",
        "uses-https": "error",
        "viewport": "error",
        "color-contrast": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
